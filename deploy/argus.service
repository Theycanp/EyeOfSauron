[Unit]
Description=EyeOfSauron event monitoring and ntfy delivery
Documentation=file:/opt/eyeofsauron/current/docs/OPERATIONS.md
After=network-online.target ntfy.service
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=argus
Group=argus
WorkingDirectory=/var/lib/argus
Environment=PYTHONPATH=/opt/eyeofsauron/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/argus/ntfy.env
EnvironmentFile=-/etc/argus/providers.env
ExecStart=/usr/bin/python3 -m argus --config /etc/argus/config.toml run
Restart=on-failure
RestartForceExitStatus=75
RestartSec=10s
WatchdogSec=6min
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
StateDirectory=argus
StateDirectoryMode=0700
OOMPolicy=stop

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/argus
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectProc=invisible
# Host health needs /proc/meminfo; other users' processes remain hidden.
ProcSubset=all
RemoveIPC=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

MemoryHigh=256M
MemoryMax=384M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
